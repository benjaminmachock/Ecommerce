generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  priceCents  Int
  category    String
  // Key into the artwork registry (src/lib/artwork.ts) used to render the shirt.
  artwork     String
  colors      String[]
  sizes       String[]
  featured    Boolean  @default(false)
  // Archived products are hidden from the storefront but kept for order history.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       OrderItem[]

  @@index([category])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING)
  totalCents      Int
  stripeSessionId String?     @unique
  trackingNumber  String?
  shippedAt       DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]

  @@index([userId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  size           String
  color          String
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}

// Postgres-backed fixed-window rate limiter (see src/lib/rate-limit.ts).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
